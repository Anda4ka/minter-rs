# Minter-RS .env example
# Copy this file to .env and replace placeholders.
# Do not share your real .env if it contains private RPC keys.

# ------------------------------------------------------------
# Provider API keys (recommended)
# ------------------------------------------------------------
# You can put only keys here. The bot will build RPC URLs automatically
# for the selected collection chain and then race/fallback all available nodes.
# Supported aliases also work: alchemyapikey, noderealapikey, tenderlyapikey.

ALCHEMY_API_KEY=YOUR_ALCHEMY_KEY
NODEREAL_API_KEY=YOUR_NODEREAL_KEY
TENDERLY_API_KEY=YOUR_TENDERLY_NODE_ACCESS_KEY

# Generated examples for Base from the keys above:
# Alchemy:  https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Tenderly: https://base.gateway.tenderly.co/YOUR_TENDERLY_NODE_ACCESS_KEY
# NodeReal: https://open-platform.nodereal.io/YOUR_NODEREAL_KEY/base

# ------------------------------------------------------------
# Manual RPC override (optional)
# ------------------------------------------------------------
# Manual URLs have higher priority than generated provider URLs.
# Use this if a provider has a different endpoint format or you want custom nodes.

# RPC_URLS_BASE=https://first-base-rpc,https://second-base-rpc
# RPC_URL_BASE=https://single-base-rpc
# BASE_RPC_URL=https://single-base-rpc

# Generic fallback if no chain-specific/generated RPC exists:
# RPC_URLS=https://first-fallback-rpc,https://second-fallback-rpc
# RPC_URL=https://single-fallback-rpc

# ------------------------------------------------------------
# Supported generated provider URLs
# ------------------------------------------------------------
# Alchemy:
# ethereum/mainnet -> eth-mainnet.g.alchemy.com
# base             -> base-mainnet.g.alchemy.com
# polygon/matic    -> polygon-mainnet.g.alchemy.com
# arbitrum         -> arb-mainnet.g.alchemy.com
# optimism         -> opt-mainnet.g.alchemy.com
# avalanche        -> avax-mainnet.g.alchemy.com
# blast            -> blast-mainnet.g.alchemy.com

# NodeReal:
# ethereum/mainnet -> eth-mainnet.nodereal.io
# base             -> open-platform.nodereal.io/<key>/base
# polygon/matic    -> polygon-mainnet.nodereal.io
# arbitrum         -> arbitrum-mainnet.nodereal.io
# optimism         -> opt-mainnet.nodereal.io
# avalanche        -> avalanche-mainnet.nodereal.io
# bsc              -> bsc-mainnet.nodereal.io

# Tenderly:
# ethereum/mainnet -> mainnet.gateway.tenderly.co
# base             -> base.gateway.tenderly.co
# polygon/matic    -> polygon.gateway.tenderly.co
# arbitrum         -> arbitrum.gateway.tenderly.co
# optimism         -> optimism.gateway.tenderly.co
# avalanche        -> avalanche.gateway.tenderly.co
# blast            -> blast.gateway.tenderly.co
# apechain         -> apechain.gateway.tenderly.co

# ------------------------------------------------------------
# OpenSea SeaDrop defaults
# ------------------------------------------------------------
# These are already hardcoded in the bot. Uncomment only if you need override.

# SEADROP_ADDRESS=0x00005EA00Ac477B1030CE78506496e8C2dE24bf5
# FEE_RECIPIENT=0x0000a26b00c1F0DF003000390027140000fAa719

# ------------------------------------------------------------
# Old/manual env names still supported
# ------------------------------------------------------------
# RPC_URL_<CHAIN>
# <CHAIN>_RPC_URL
# RPC_URLS_<CHAIN>
# <CHAIN>_RPC_URLS
